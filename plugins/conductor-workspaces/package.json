{
  "name": "bb-plugin-conductor-workspaces",
  "version": "0.3.7",
  "type": "module",
  "exports": {
    "./core": {
      "source": "./src/core.ts",
      "types": "./src/core.ts",
      "default": "./src/core.ts"
    },
    "./rpc-contract": {
      "source": "./src/rpc-contract.ts",
      "types": "./src/rpc-contract.ts",
      "default": "./src/rpc-contract.ts"
    },
    "./conductor.css": "./src/conductor.css"
  },
  "description": "The BBamir repository, workspace, and conversation sidebar for BB.",
  "license": "MIT",
  "files": [
    "dist",
    "app.tsx",
    "src",
    "components",
    "hooks",
    "lib",
    "types",
    "components.json",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "bb": ">=0.36.0-bbamir.1",
    "bbPluginSdk": "^0.4.1"
  },
  "bb": {
    "name": "BBamir Workspaces",
    "description": "Organize native BB environments as workspaces with shared conversation tabs.",
    "branding": {
      "icon": "PanelsTopLeft"
    },
    "app": "./app.tsx",
    "server": "./src/server.ts"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "build": "pnpm -C ../.. exec node --conditions=source --import tsx scripts/build-workspace-plugin.mjs conductor-workspaces",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "better-sqlite3": "12.10.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vaul": "^1.1.2",
    "vitest": "4.1.1"
  }
}
